# Northlight · REALCAPTURE · Cloudflare Pages Functions
# Copy values into Cloudflare Pages > Settings > Variables and Secrets.
# Never commit real secrets.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NORTHLIGHT_DEMO_KEY=

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
PILOT_LOGIN_PASSWORD=

# Canonical HTTPS application origin. OAuth and Calendar webhook setup fail
# closed when the incoming host differs from this value.
PUBLIC_ORIGIN=https://portal.example.com

# Prefer separate Google Cloud projects so revoking one grant cannot revoke
# both shared Workspace mail and a photographer's personal Calendar grant.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Legacy fallback only; dedicated credentials above are preferred.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_FROM=quixoticpradip@gmail.com
DEMO_EMAIL_TO=pradeeppatilfg@gmail.com

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ROOT=/Northlight

# Optional until REALCAPTURE connects Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=
# Required only when the authorising Xero user exposes multiple organisations.
XERO_TENANT_ID=
